# Private/local dataset (never publish)
SLclean/

# Python environments and generated files
.venv/
.venv.python310-broken/
__pycache__/
*.py[cod]
node_modules/
*.log

# Local speech-recognition model and downloaded archive
vosk-model-small-en-us-0.15/
vosk-model-small-en-us-0.15.zip

# Editor settings and temporary files
.vscode/
*.bak
.pose-animator-git-backup/

